		displayFolder: 5 Outreach
		lineageTag: c56beec1-dbbf-513d-a24e-afce2ce240f8

	measure 'Roster Conversion' = CALCULATE(DIVIDE([Orgs With Roster], [Orgs Contacted]), REMOVEFILTERS('Dim Date'))
		formatString: 0.0%
		displayFolder: 5 Outreach
		lineageTag: 8b9ada4d-de0a-5796-9ef7-f1f7bd6fcc3c

	/// Recurring weekly billable hours now active from contacted organisations, per 100 contacted.
	measure 'Hours per 100 Orgs Contacted' = DIVIDE(SUM('Fact Roster'[active_hours_from_contacted_orgs]), [Orgs Contacted (all time)]) * 100
		formatString: #,0.0
		displayFolder: 5 Outreach
		lineageTag: 39863ac0-ba2a-57c7-8dc2-7c50f659ba22

	/// Actual revenue from contacted organisations, per 100 contacted.
	measure 'Revenue per 100 Orgs Contacted' = DIVIDE(CALCULATE(SUM('Fact Revenue'[revenue_from_contacted_orgs]), REMOVEFILTERS('Dim Date')), [Orgs Contacted (all time)]) * 100
		formatString: $#,0
		displayFolder: 5 Outreach
		lineageTag: ea8989c9-09db-5618-8afe-a0a0bdb4be31

