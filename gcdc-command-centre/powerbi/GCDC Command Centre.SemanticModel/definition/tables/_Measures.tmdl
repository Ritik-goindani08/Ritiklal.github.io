	column 'Measure Table'
		dataType: string
		isHidden
		lineageTag: c69b122b-7c2b-51ff-8fe9-707d7fa25467
		summarizeBy: none
		sourceColumn: Measure Table

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Measure Table" = text], {})
				in
				    Source

	annotation PBI_ResultType = Table
